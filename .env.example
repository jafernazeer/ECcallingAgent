# Vapi browser public key and assistant ID are currently configured in src/main.jsx.

# Supabase browser Realtime credentials. These are safe to expose in Vite.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase server-side database credential. Never expose this in browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional shared secret for Vapi Server URL requests.
# Send it from Vapi as either Authorization: Bearer <secret> or x-vapi-secret: <secret>.
VAPI_PRIVATE_API_KEY=your-vapi-private-api-key
VAPI_ASSISTANT_ID=429bb390-be3c-4b1e-bc3a-2a717917725c
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret

# Optional SMTP credentials for sending call-summary emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@your-domain.com
SMTP_PASS=your-smtp-password-or-app-password
EMAIL_FROM="EthikCorp EC Calling Agent <notifications@your-domain.com>"

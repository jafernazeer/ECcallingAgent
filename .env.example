# Supabase browser credentials. These are safe to expose in Vite.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Vapi browser credentials. Public SDK keys are safe to expose in Vite.
VITE_VAPI_PUBLIC_KEY=f80cea3b-d773-4f2c-88a8-8d7c87cd57ee
VITE_VAPI_ASSISTANT_ID=da9e9bf5-29e1-4d97-bd4b-f1dc3a97fe76
VITE_VAPI_API_BASE_URL=/api/vapi

# Optional local/dashboard event endpoint used by the standalone portal.
VITE_DASHBOARD_EVENTS_URL=http://localhost:5172/api/call-events

# Supabase server-side credential. Never expose this in browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
